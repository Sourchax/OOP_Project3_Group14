<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AddMovieController">
    <Label style="-fx-font-size: 16;" text="Add a New Movie" />
    <TextField fx:id="titleField" promptText="Enter movie title" />
    <TextField fx:id="yearField" promptText="Enter movie release year" />
   <Label fx:id="genreField" text="Label" />
   <Button fx:id="addGenreButton" mnemonicParsing="false" text="Add Genre(s)" />
    <TextField fx:id="summaryField" promptText="Enter movie summary" />
    
    <Button fx:id="uploadImageButton" onAction="#onUploadImage" text="Upload Image" />
    
    <ImageView fx:id="imageView" fitHeight="150.0" fitWidth="200.0" preserveRatio="true" />
    
    <HBox alignment="CENTER" spacing="10">
        <Button onAction="#onAddMovie" text="Add" />
        <Button onAction="#onCancel" text="Cancel" />
    </HBox>
</VBox>
