<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.seatPlanController">
    <!-- Header -->
    <top>
        <Label text="Cinema Seat Selection" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 10px;"/>
    </top>

    <!-- Seat Layout -->
    <center>
        <GridPane fx:id="seatGrid" hgap="5" vgap="5" style="-fx-padding: 10px;">
            <!-- Seats will be dynamically added here from Java code -->
        </GridPane>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10px;">
            <Label text="Available: " style="-fx-font-size: 14px;"/>
            
            <Label text="Occupied: " style="-fx-font-size: 14px;"/>

            <Label text="Selected: " style="-fx-font-size: 14px;"/>
        </HBox>
    </bottom>
</BorderPane>