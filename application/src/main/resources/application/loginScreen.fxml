<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="application.LoginController">
    <left>
        <VBox alignment="CENTER" prefWidth="300" spacing="20" style="-fx-background-color: #0f1c0e;">
            <Label style="-fx-font-size: 24; -fx-text-fill: white;" text="Welcome" />
            <Label style="-fx-text-fill: white; -fx-font-size: 14;" text="Please Enter your Account details" wrapText="true">
            <VBox.margin>
               <Insets />
            </VBox.margin></Label>
            <VBox alignment="CENTER" spacing="10">
                <TextField fx:id="usernameField" promptText="Username" />
                <PasswordField fx:id="passwordField" promptText="Password" />
               <Button fx:id="signInButton" style="-fx-background-color: #4caf50; -fx-text-fill: white;" text="Sign in" />
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-background-color: #2a9d8f;">
            <Label style="-fx-font-size: 20; -fx-text-fill: white;" text="What's our Jobseekers Said." />
            <Label style="-fx-font-size: 14; -fx-text-fill: white;" text="“Search and find your dream job is now easier than ever.                           Just browse a job and apply if you need to.”" wrapText="true" />
            <Label style="-fx-font-size: 12; -fx-text-fill: white;" text="Mas Parjono - UI Designer at Google" />
            <Button fx:id="nextQuoteButton" text="→" />
            <VBox spacing="10">
                <Label style="-fx-font-size: 16; -fx-text-fill: white;" text="Get your right job and right place apply now" />
                <Label style="-fx-font-size: 12; -fx-text-fill: white;" text="Be among the first founders to experience the easiest way to start running a business." wrapText="true" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
