<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainPane" minHeight="640.0" minWidth="800.0" stylesheets="@../styles/inventory.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.InventoryController">
   <left>
      <VBox fx:id="sideBar" alignment="TOP_CENTER" minHeight="400.0" minWidth="275.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
          <Label alignment="CENTER" contentDisplay="CENTER" layoutX="982.0" layoutY="14.0" minHeight="50.0" minWidth="200.0" text="Inventory">
         <font>
            <Font name="Calibri" size="35.0" />
         </font>
      </Label>
            <TextField promptText="Search" />
            <VBox fx:id="chosenProductCard" alignment="CENTER" spacing="20.0">
               <children>
                  <ImageView fx:id="productImage" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
                  <Label fx:id="productNameLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="26.0" prefWidth="70.0" text="name">
                     <font>
                        <Font name="Calibri" size="20.0" />
                     </font></Label>
                  <Label fx:id="productQuantityLabel" alignment="CENTER" contentDisplay="CENTER" prefHeight="26.0" prefWidth="70.0" text="quantity">
                     <font>
                        <Font name="Calibri" size="20.0" />
                     </font>
                  </Label>
                  <Label fx:id="productPriceLabel" text="price">
                     <font>
                        <Font size="20.0" />
                     </font></Label>
                  <ComboBox minWidth="150.0" />
                  <Button mnemonicParsing="false" text="Button" />
               </children>
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <HBox alignment="CENTER" minHeight="600.0" minWidth="700.0" spacing="10.0" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
         <children>
            <ScrollPane fx:id="productsScrollPane" minHeight="568.0" minWidth="700.0" prefHeight="568.0" prefWidth="822.0">
               <content>
                  <GridPane fx:id="productsGrid" alignment="CENTER" hgap="20.0" minHeight="0.0" minWidth="0.0" vgap="20.0">
                     <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" />
                     </rowConstraints>
                  </GridPane>
               </content>
               <HBox.margin>
                  <Insets top="10.0" />
               </HBox.margin>
               <padding>
                  <Insets left="10.0" top="10.0" />
               </padding>
            </ScrollPane>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </center>
</BorderPane>