<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" minHeight="640.0" minWidth="800.0" prefHeight="713.0" prefWidth="1118.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.EmployeesController">
   <left>
      <VBox fx:id="sideBar" alignment="TOP_CENTER" minHeight="400.0" minWidth="275.0" prefHeight="725.0" prefWidth="337.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <TextField promptText="Search" />
            <VBox fx:id="chosenProductCard" alignment="CENTER" prefHeight="533.0" prefWidth="323.0" spacing="20.0">
               <children>
                  <HBox spacing="20.0">
                     <children>
                        <Label prefHeight="25.0" prefWidth="100.0" text="Name: " />
                        <TextField fx:id="nameField" alignment="CENTER" prefHeight="25.0" prefWidth="187.0" text="Name" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label prefHeight="25.0" prefWidth="100.0" text="Surname" />
                        <TextField fx:id="surnameField" alignment="CENTER" prefHeight="25.0" prefWidth="187.0" text="Surname" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label prefHeight="25.0" prefWidth="100.0" text="Username" />
                        <TextField fx:id="usernameField" alignment="CENTER" prefHeight="25.0" prefWidth="185.0" text="Username" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label prefHeight="25.0" prefWidth="100.0" text="Password" />
                        <TextField fx:id="passwordField" alignment="CENTER" prefHeight="25.0" prefWidth="185.0" text="Password" />
                     </children>
                  </HBox>
                  <HBox alignment="TOP_CENTER" prefHeight="186.0" prefWidth="290.0" spacing="30.0">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <children>
                        <ComboBox fx:id="roleComboBox" prefWidth="150.0" promptText="Select a role" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER" spacing="30.0">
                     <children>
                        <Button fx:id="editButton" mnemonicParsing="false" text="Edit" />
                        <Button fx:id="deleteButton" mnemonicParsing="false" text="Delete" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
               </padding>
            </VBox>
            <Button fx:id="addEmployeeButton" mnemonicParsing="false" onMousePressed="#hireEmployee" text="Add Employee" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="50.0" />
         </padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </left>
   <center>
      <HBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="600.0" minWidth="700.0" prefHeight="715.0" prefWidth="862.0" spacing="10.0" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="20.0" top="20.0" />
         </padding>
         <children>
            <AnchorPane prefHeight="743.0" prefWidth="754.0">
               <children>
                  <TableView fx:id="employeesTableView" layoutX="16.0" layoutY="27.0" prefHeight="620.0" prefWidth="753.0">
                    <columns>
                      <TableColumn fx:id="idColumn" prefWidth="125.0" text="Employee ID" />
                        <TableColumn fx:id="nameColumn" prefWidth="125.0" text="Name" />
                        <TableColumn fx:id="surnameColumn" prefWidth="125.0" text="Surname" />
                        <TableColumn fx:id="usernameColumn" prefWidth="125.0" text="Username" />
                        <TableColumn fx:id="roleColumn" prefWidth="125.0" text="Role" />
                        <TableColumn fx:id="passwordColumn" prefWidth="125.0" text="Password" />
                    </columns>
                  </TableView>
               </children>
               <padding>
                  <Insets left="10.0" right="10.0" />
               </padding>
            </AnchorPane>
         </children>
      </HBox>
   </center>
</BorderPane>
