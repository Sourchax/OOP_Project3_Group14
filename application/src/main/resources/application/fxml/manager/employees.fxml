<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" minHeight="640.0" minWidth="800.0" prefHeight="600.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.EmployeesController">
   <left>
      <VBox fx:id="sideBar" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="400.0" minWidth="275.0" prefHeight="725.0" prefWidth="337.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox spacing="20.0">
               <children>
                  <Label prefHeight="25.0" prefWidth="100.0" text="Name: " />
                  <TextField fx:id="nameField" alignment="CENTER" prefHeight="25.0" prefWidth="187.0" text="Name" />
               </children>
            </HBox>
            <HBox spacing="20.0">
               <children>
                  <Label prefHeight="25.0" prefWidth="100.0" text="Surname" />
                  <TextField fx:id="surnameField" alignment="CENTER" prefHeight="25.0" prefWidth="187.0" text="Surname" />
               </children>
            </HBox>
            <HBox spacing="20.0">
               <children>
                  <Label prefHeight="25.0" prefWidth="100.0" text="Username" />
                  <TextField fx:id="usernameField" alignment="CENTER" prefHeight="25.0" prefWidth="185.0" text="Username" />
               </children>
            </HBox>
            <HBox spacing="20.0">
               <children>
                  <Label prefHeight="25.0" prefWidth="100.0" text="Password" />
                  <TextField fx:id="passwordField" alignment="CENTER" prefHeight="25.0" prefWidth="185.0" text="Password" />
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="60.0" prefWidth="307.0" spacing="30.0">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <children>
                  <ComboBox fx:id="roleComboBox" prefWidth="150.0" promptText="Select a role" />
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <Button fx:id="editButton" mnemonicParsing="false" text="Edit" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" text="Delete" />
               </children>
            </HBox>
            <Button fx:id="addEmployeeButton" mnemonicParsing="false" onMouseClicked="#hireEmployee" prefHeight="0.0" text="Add Employee" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="50.0" />
         </padding>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </left>
   <center>
      <TableView fx:id="employeesTableView" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="550.0" prefWidth="750.0" BorderPane.alignment="TOP_CENTER">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="125.0" text="Employee ID" />
            <TableColumn fx:id="nameColumn" prefWidth="125.0" text="Name" />
            <TableColumn fx:id="surnameColumn" prefWidth="125.0" text="Surname" />
            <TableColumn fx:id="usernameColumn" prefWidth="125.0" text="Username" />
            <TableColumn fx:id="roleColumn" prefWidth="125.0" text="Role" />
            <TableColumn fx:id="passwordColumn" prefWidth="125.0" text="Password" />
        </columns>
         <BorderPane.margin>
            <Insets top="30.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
