<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane onMousePressed="#click" styleClass="anchor-pane" stylesheets="@../styles/product.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ProductController">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="63.0" layoutY="8.0" prefHeight="215.0" prefWidth="225.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="TOP_CENTER" prefHeight="50.0" prefWidth="185.0">
               <children>
                  <Label fx:id="nameLabel" alignment="CENTER" prefHeight="50.0" prefWidth="137.0" text="product">
                     <font>
                        <Font name="Calibri" size="25" />
                     </font>
                  </Label>
                  <Label fx:id="priceLabel" alignment="CENTER" prefHeight="50.0" prefWidth="100.0" text="\$0.99">
                     <font>
                        <Font name="Calibri" size="20" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </HBox>
            <ImageView fx:id="productImage" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../deneme.jpg" />
               </image></ImageView>
         </children>
      </VBox>
   </children>
</AnchorPane>